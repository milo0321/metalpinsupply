---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, useTranslations, getLocalizedPath, getMicroHookLabels } from '../../i18n/utils';
import { localizeInsightMeta, localizeInsightFaqs, localizeInsightHtml } from '../../i18n/insightAndCollectionLocalization';
import { localizeProduct, localizeTitle } from '../../i18n/productLocalization';

export async function getStaticPaths() {
  const guides = await getCollection('insights');
  const allProducts = await getCollection('products');

  return guides.map((guide, idx) => {
    const relatedSkus = guide.data.relatedSkus || [];
    const relatedProducts = allProducts.filter((p) => relatedSkus.includes(p.data.sku)).slice(0, 8);
    const relatedGuides: typeof guides = [];
    for (let offset = 1; offset <= 4 && offset < guides.length; offset++) {
      relatedGuides.push(guides[(idx + offset) % guides.length]);
    }
    return {
      params: { slug: guide.data.slug },
      props: { guide, relatedProducts, relatedGuides }
    };
  });
}

const { guide, relatedProducts, relatedGuides = [] } = Astro.props;
const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const locGuideMeta = localizeInsightMeta(guide.data, currentLang);
await render(guide);
const rawGuideHtml = guide.rendered?.html || guide.body || '';
const localizedGuideHtml =
  currentLang === 'en'
    ? rawGuideHtml
    : localizeInsightHtml(rawGuideHtml, guide.data, currentLang).replace(
        /href="(\/(?:products|collections|insights|custom-branding|custom-packaging|compliance-safety|about|contact)[^"]*)"/g,
        (_m: string, p1: string) => `href="${getLocalizedPath(p1, currentLang)}"`
      );

function buildDefaultGuideFaqs(g: any, relProds: any[]): { question: string; answer: string }[] {
  const topic = (g.metaTitle || g.title || '').split(':')[0].trim();
  const styleList = relProds && relProds.length ? relProds.slice(0, 3).map((rp: any) => rp.data.title).join(', ') : 'Custom Hard Enamel Lapel Pins, 3D Marathon Medals & Challenge Coins';
  const lowP = relProds && relProds.length ? relProds[0].data.tier2000 : '0.45';
  const moqP = relProds && relProds.length ? (relProds[0].data.moqNum || 100) : 100;

  return [
    {
      question: `What is the factory MOQ and unit price range covered in "${topic}"?`,
      answer: `Custom production batches across these craft formats (${styleList}) typically start at ${moqP} pcs per artwork design (from $0.14/pc on buttons/clips to $${lowP}+/pc at 2,000+ pcs on heavy die-struck and 3D cast formats). Exact ex-works USD pricing depends on custom dimensions, metal thickness, and plating finish.`
    },
    {
      question: 'What do custom stamping dies and 3D casting molds cost, and when is tooling waived?',
      answer: 'Standard 2D stamped lapel pin and trolley coin dies cost $55–$85 USD (automatically waived at 500+ pcs per design). Custom 3D zinc die-cast molds for marathon medals, challenge coins, and badges cost $95–$150 USD (waived at 1,000+ pcs). All custom steel dies are archived free for 3 years for zero-fee reorders.'
    },
    {
      question: 'Should buyers select Cloisonne Hard Enamel, Die-Struck Soft Enamel, or 3D Zinc Die-Casting?',
      answer: 'Choose Cloisonne Hard Enamel for flush-ground jewelry smoothness and corporate/service awards, Die-Struck Soft Enamel for vivid recessed Pantone colors and bold relief edges at 15%–25% lower cost, or 3D Zinc Alloy Die-Casting for contoured multi-level medals, thick coins, and intricate cut-out shapes.'
    },
    {
      question: 'How fast can I receive a digital artwork proof before opening custom tooling?',
      answer: 'Upload your vector (.AI, .EPS, .PDF, .SVG) or sketch via /contact or WhatsApp (+86 187 5012 6315). Our Zhongshan artwork team returns a scaled 1:1 Pantone color and die-line proof completely free within 12 hours prior to production.'
    },
    {
      question: 'What electroplating finishes and specialty color effects are available?',
      answer: 'Standard electroplating includes bright gold, nickel/silver, brass, copper, black nickel, matte black, antique bronze/brass/silver, plus dual-tone selective masking, rainbow anodized PVD, translucent stained glass, glitter, glow-in-the-dark, and optical clear epoxy domes.'
    },
    {
      question: 'Can I request a paid pre-production physical sample before bulk mass production?',
      answer: 'Yes. Physical sample strikes ship within 7–10 business days via DHL/FedEx express once custom tooling is engraved, allowing race directors, uniform officers, and brands to inspect color fidelity, weight, and attachment hardware before approving full batch finishing.'
    },
    {
      question: `How are attachments and hardware configured for these custom styles (${styleList})?`,
      answer: (g.slug || '').includes('fridge-magnet')
        ? 'Custom metal fridge magnets feature recessed N35–N52 nickel-plated neodymium discs locked with flush structural epoxy for heavy 3D zinc or kinetic pieces, sintered ceramic ferrite discs for tourist landmarks, or full-back 1.5mm die-cut anisotropic soft rubber magnets and clear EVA bumper pads that grip stainless steel appliances without scratching.'
        : 'Lapel pins come standard with brass butterfly clutches, rubber PVC backs, deluxe locking clutches, or clothing-safe neodymium magnetic bars. Medals include custom dye-sublimated 25×850mm satin ribbons or drape mounts; keychains and trolley tokens use chrome split rings or swivel lobster clasps.'
    },
    {
      question: 'What retail and gift packaging upgrades are manufactured in-house?',
      answer: 'Standard items ship individually polybagged at $0.00 extra cost. Optional retail upgrades include 400gsm matte or foil-stamped backing cards (+$0.12–$0.22/pc), crystal-clear non-PVC acrylic coin capsules (+$0.15–$0.35/pc), and hinged velvet clamshell gift boxes (+$0.85–$1.85/pc).'
    },
    {
      question: 'Do MedalPinSupply alloys, enamels, and electroplatings meet US CPSIA and EU REACH standards?',
      answer: 'Yes. We cast certified lead-free Zamak #3 zinc (<0.005% Pb), C26800 brass, non-phthalate Pantone enamels, and soft PVC meeting US CPSIA (<90 ppm lead), California Prop 65, EU EN71-3, and EN 1811 nickel-release directives.'
    },
    {
      question: 'What are standard bulk production lead times and DDP international air shipping speeds?',
      answer: 'Bulk production runs 7–12 business days for stamped pins and coins and 10–15 business days for 3D die-cast medals or badges. Turnkey DDP air courier delivers door-to-door in 5–7 business days directly from Guangdong.'
    }
  ];
}

const guideFaqs = buildDefaultGuideFaqs(guide.data, relatedProducts);
const localizedGuideFaqs = localizeInsightFaqs(guide.data.slug, guideFaqs, currentLang);

// Dynamic Reading Time Calculation based on actual text, technical tables, and FAQ elements
const rawText = guide.body ? guide.body.replace(/<[^>]*>?/gm, ' ') : '';
const wordCount = rawText.split(/\s+/).filter((word) => word.length > 0).length;
const tableCount = (guide.body ? guide.body.match(/<table/g) || [] : []).length;
const faqCount = localizedGuideFaqs.length;
const computedReadingMinutes = Math.max(
  8,
  Math.round(wordCount / 160 + tableCount * 1.5 + faqCount * 0.45)
);
const dynamicReadTime = `${computedReadingMinutes} ${t('unit.minRead')}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': ['TechArticle', 'BlogPosting'],
  headline: locGuideMeta.title,
  description: locGuideMeta.summary,
  image: [`https://medalpinsupply.com${guide.data.featuredImage}`],
  datePublished: guide.data.publishDate,
  dateModified: guide.data.updatedDate || guide.data.publishDate,
  author: {
    '@type': 'Organization',
    name: locGuideMeta.author,
    '@id': 'https://medalpinsupply.com/#organization'
  },
  publisher: {
    '@id': 'https://medalpinsupply.com/#organization'
  },
  mentions: relatedProducts.map((rp: any) => ({
    '@type': 'Product',
    sku: rp.data.sku,
    name: localizeTitle(rp.data.title, currentLang),
    image: `https://medalpinsupply.com${rp.data.featuredImage}`,
    url: `https://medalpinsupply.com${getLocalizedPath(`/products/${rp.data.slug}`, currentLang)}`,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: String(rp.data.tier2000),
      highPrice: String(rp.data.tier100),
      offerCount: 3,
      availability: 'https://schema.org/InStock'
    }
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('breadcrumb.home'),
      item: `https://medalpinsupply.com${getLocalizedPath('/', currentLang)}`
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('breadcrumb.guides'),
      item: `https://medalpinsupply.com${getLocalizedPath('/insights', currentLang)}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: locGuideMeta.title,
      item: `https://medalpinsupply.com${getLocalizedPath(`/insights/${guide.data.slug}`, currentLang)}`
    }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedGuideFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};
---

<Layout
  title={currentLang === 'en' ? guide.data.metaTitle : `${locGuideMeta.title} | MedalPinSupply`}
  description={currentLang === 'en' ? guide.data.metaDescription : locGuideMeta.summary}
  ogImage={guide.data.featuredImage}
  preloadImage={guide.data.featuredImage}
  activePage="insights"
  jsonLd={[articleSchema, breadcrumbSchema, faqSchema]}
>
  <article class="guide-article">
    <header class="grand-hero">
      <div class="container" style="max-width: 1040px;">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
          <span class="bc-sep">/</span>
          <a href={getLocalizedPath('/insights', currentLang)}>{t('breadcrumb.guides')}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{locGuideMeta.category}</span>
        </nav>

        <div class="hero-badges-row">
          <span class="badge badge-dark">{locGuideMeta.category}</span>
          <span class="badge badge-gold">{dynamicReadTime}</span>
        </div>

        <h1 class="grand-hero-title">{locGuideMeta.title}</h1>
        <p class="grand-hero-lead" style="max-width: 920px;">{locGuideMeta.summary}</p>

        <div class="article-meta-bar">
          <div class="meta-author-block">
            <div class="meta-avatar">MPS</div>
            <div class="meta-col">
              <span class="meta-label">{t('guide.by')}</span>
              <strong class="meta-val">{locGuideMeta.author}</strong>
            </div>
          </div>
          <div class="meta-divider"></div>
          <div class="meta-col">
            <span class="meta-label">{t('guide.updated')}</span>
            <strong class="meta-val">{guide.data.updatedDate || guide.data.publishDate}</strong>
          </div>
          <div class="meta-divider"></div>
          <div class="meta-col">
            <span class="meta-label">{t('guide.tocTitle')}</span>
            <strong class="meta-val">{dynamicReadTime}</strong>
          </div>
        </div>
      </div>
    </header>

    <!-- 3-COLUMN BACKLINKO PUBLICATION ARCHITECTURE -->
    <div class="container article-layout-grid">
      <!-- LEFT SIDEBAR: Sticky Table of Contents -->
      <aside class="article-sidebar left-sidebar" aria-label="Table of Contents">
        <div class="sticky-wrapper">
          <h4 class="sidebar-title">{t('guide.tocTitle')}</h4>
          <nav id="toc-container" class="toc-nav">
            <!-- Dynamically populated by inline script -->
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Main Skyscraper Article -->
      <div class="article-main">
        <!-- Featured Hero Image -->
        <div class="article-featured-image-wrap">
          <img
            src={guide.data.featuredImage}
            alt={locGuideMeta.title}
            width="800"
            height="600"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Executive Engineering Summary Callout -->
        <GeoDirectAnswer
          title={t('guide.execBriefTitle')}
          answer={locGuideMeta.summary}
        />

        <!-- Above-the-Fold Matched Custom Craft Styles & Proof Strip -->
        {relatedProducts.length > 0 && (
          <div class="guide-fast-track-bar" aria-label={t('guide.refModelsTitle')}>
            <div class="fast-track-head">
              <span class="fast-track-title">⚡ {t('guide.refModelsTitle')}</span>
            </div>
            <div class="fast-track-chips">
              {relatedProducts.slice(0, 6).map((rp: any) => {
                const locP = localizeProduct(rp.data, currentLang);
                return (
                  <a
                    href={getLocalizedPath(`/products/${rp.data.slug}`, currentLang)}
                    class="fast-sku-chip"
                    data-fast-sku={locP.title}
                  >
                    <img src={rp.data.featuredImage} alt={locP.title} width="44" height="33" loading="eager" />
                    <div class="fast-sku-meta">
                      <span class="fast-sku-code">${rp.data.tier2000}+/{t('unit.pc')} · MOQ {rp.data.moqNum}</span>
                      <span class="fast-sku-name">{locP.title}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <form
          class="inline-quick-sheet-form"
          data-inline-sku={relatedProducts.length > 0 ? `${relatedProducts.slice(0, 3).map((rp: any) => rp.data.title).join(', ')} (${guide.data.slug})` : `Guide Inquiry (${guide.data.slug})`}
          novalidate
        >
          <div class="inline-qrfq-text">
            <strong>{microHooks.getFullSheetPdf}</strong>
            <span>{microHooks.mixMoqBadge}</span>
          </div>
          <div class="inline-qrfq-controls">
            <input
              type="email"
              class="inline-qrfq-input"
              placeholder={`${t('contact.workEmail')} (name@company.com)`}
              aria-label={t('contact.workEmail')}
              required
            />
            <button type="submit" class="inline-qrfq-btn">
              ⚡ {microHooks.sheet140} →
            </button>
          </div>
          <div class="inline-qrfq-status" hidden></div>
        </form>

        <!-- Mobile & Tablet Quick-Jump Table of Contents (Visible <= 1180px) -->
        <details class="mobile-toc-box">
          <summary class="mobile-toc-summary">
            <span>📑 {t('guide.tocTitle')}</span>
            <span class="mobile-toc-chevron">▾</span>
          </summary>
          <nav id="mobile-toc-container" class="mobile-toc-nav" aria-label="Mobile Table of Contents"></nav>
        </details>

        <!-- Main Editorial Content -->
        <div class="prose article-body clean-editorial-content" set:html={localizedGuideHtml} />

        <!-- Referenced Custom Craft Styles -->
        {relatedProducts.length > 0 && (
          <section class="related-skus-section" id="referenced-factory-models">
            <div class="related-skus-head">
              <h2>{t('guide.refModelsTitle')}</h2>
              <a
                href={getLocalizedPath('/contact', currentLang)}
                class="btn btn-primary btn-sm"
                data-rfq-sku={relatedProducts.slice(0, 3).map((rp: any) => rp.data.title).join(', ')}
                data-rfq-qty="100"
              >
                {t('nav.requestQuote')} &rarr;
              </a>
            </div>
            <div class="grid-3">
              {relatedProducts.slice(0, 6).map((p: any) => (
                <ProductCard product={p} />
              ))}
            </div>
          </section>
        )}

        <!-- Related Engineering Insights Box -->
        {relatedGuides.length > 0 && (
          <section class="related-guides-box" id="related-engineering-insights">
            <span class="badge">{t('guide.continueBadge')}</span>
            <h2>{t('guide.relatedGuidesTitle')}</h2>
            <div class="related-guides-grid">
              {relatedGuides.map((rg: any) => {
                const rgLoc = localizeInsightMeta(rg.data, currentLang);
                return (
                  <a href={getLocalizedPath(`/insights/${rg.data.slug}`, currentLang)} class="related-guide-card">
                    <img src={rg.data.featuredImage} alt={rgLoc.title} width="400" height="300" loading="lazy" />
                    <div class="related-guide-body">
                      <span class="related-guide-cat">{rgLoc.category}</span>
                      <h3>{rgLoc.title}</h3>
                      <span class="related-guide-cta">{t('guides.readCta')}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <!-- Guide 10-FAQ Section -->
        <section class="section section-light guide-faq-section" id="frequently-asked-questions">
          <div class="section-header-center">
            <span class="badge">{t('guides.faqBadge')}</span>
            <h2 class="section-title">{t('pdp.faqTitle')} — {locGuideMeta.category}</h2>
          </div>
          <div class="faq-list">
            {localizedGuideFaqs.map((faq, idx) => (
              <div class:list={['accordion-item', { active: idx === 0 }]}>
                <button type="button" class="accordion-header">
                  <span>{faq.question}</span>
                  <span class="accordion-icon">+</span>
                </button>
                <div class="accordion-content">
                  <p>{faq.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Author & Engineering Lab Credentials Card -->
        <div class="author-credential-card">
          <div class="author-info-wrap">
            <span class="author-sub">{t('guide.authorSub')}</span>
            <h4 class="author-name">{t('guide.authorName')}</h4>
            <p class="author-bio">
              {t('guide.authorBio')}
            </p>
          </div>
        </div>
      </div>

      <!-- RIGHT SIDEBAR: Floating Minimalist Share & Instant Quote Icon Dock -->
      <aside class="article-sidebar right-sidebar" aria-label="Quick Share & Sourcing Actions">
        <div class="sticky-wrapper">
          <div class="share-dock-card">
            <button type="button" class="dock-btn btn-linkedin" id="share-linkedin" aria-label="Share on LinkedIn" title="Share on LinkedIn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </button>

            <button type="button" class="dock-btn btn-x" id="share-twitter" aria-label="Share on X" title="Share on X">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </button>

            <button type="button" class="dock-btn btn-whatsapp" id="share-whatsapp" aria-label="Share on WhatsApp" title="Share on WhatsApp">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </button>

            <button type="button" class="dock-btn btn-copy" id="share-copy" aria-label="Copy Link" title="Copy Link">
              <svg class="icon-link" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>

            <div class="dock-divider"></div>

            <a
              href={getLocalizedPath('/contact', currentLang)}
              class="dock-btn btn-rfq"
              aria-label={t('nav.requestQuote')}
              title={t('nav.requestQuote')}
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>
</Layout>

<script is:inline>
  (function () {
    // 1. Dynamic TOC & Scrollspy (Desktop + Mobile Accordion)
    var tocNav = document.getElementById('toc-container');
    var mobileTocNav = document.getElementById('mobile-toc-container');
    var articleBody = document.querySelector('.article-main');
    if (articleBody) {
      var headings = articleBody.querySelectorAll('h2');
      if (headings.length) {
        var ul = document.createElement('ul');
        var mobileUl = document.createElement('ul');
        headings.forEach(function (h, idx) {
          if (!h.id) {
            h.id = 'section-' + (idx + 1);
          }
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#' + h.id;
          a.textContent = h.textContent;
          li.appendChild(a);
          ul.appendChild(li);

          var mLi = document.createElement('li');
          var mA = document.createElement('a');
          mA.href = '#' + h.id;
          mA.textContent = h.textContent;
          mA.addEventListener('click', function () {
            var detailsBox = mA.closest('details');
            if (detailsBox) detailsBox.removeAttribute('open');
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'guide_toc_click', { section_id: h.id, page_path: window.location.pathname });
            }
          });
          mLi.appendChild(mA);
          mobileUl.appendChild(mLi);
        });
        if (tocNav) tocNav.appendChild(ul);
        if (mobileTocNav) mobileTocNav.appendChild(mobileUl);

        var tocLinks = tocNav ? tocNav.querySelectorAll('a') : [];
        if (tocLinks.length && 'IntersectionObserver' in window) {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  var activeId = entry.target.id;
                  tocLinks.forEach(function (link) {
                    link.classList.toggle('active', link.getAttribute('href') === '#' + activeId);
                  });
                }
              });
            },
            { rootMargin: '-15% 0px -78% 0px', threshold: 0 }
          );
          headings.forEach(function (h) {
            observer.observe(h);
          });
        }
      }
    }

    // Track Fast-Track SKU & RFQ clicks
    document.querySelectorAll('.fast-sku-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'guide_fast_sku_click', {
            sku: chip.getAttribute('data-fast-sku') || '',
            page_path: window.location.pathname
          });
        }
      });
    });
    var fastRfqBtn = document.querySelector('.fast-track-rfq-btn');
    if (fastRfqBtn) {
      fastRfqBtn.addEventListener('click', function () {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'guide_fast_rfq_click', {
            skus: fastRfqBtn.getAttribute('data-rfq-sku') || '',
            page_path: window.location.pathname
          });
        }
      });
    }

    // 2. Social Share & Copy Link Dock Buttons
    var shareUrl = encodeURIComponent(window.location.href);
    var shareTitle = encodeURIComponent(document.title);

    var linkedinBtn = document.getElementById('share-linkedin');
    if (linkedinBtn) {
      linkedinBtn.addEventListener('click', function () {
        window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + shareUrl, '_blank');
      });
    }

    var twitterBtn = document.getElementById('share-twitter');
    if (twitterBtn) {
      twitterBtn.addEventListener('click', function () {
        window.open('https://twitter.com/intent/tweet?url=' + shareUrl + '&text=' + shareTitle, '_blank');
      });
    }

    var whatsappBtn = document.getElementById('share-whatsapp');
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', function () {
        window.open('https://api.whatsapp.com/send?text=' + shareTitle + '%20' + shareUrl, '_blank');
      });
    }

    var copyBtn = document.getElementById('share-copy');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(window.location.href).then(function () {
            var iconLink = copyBtn.querySelector('.icon-link');
            var iconCheck = copyBtn.querySelector('.icon-check');
            copyBtn.classList.add('copied');
            if (iconLink) iconLink.style.display = 'none';
            if (iconCheck) iconCheck.style.display = 'block';
            setTimeout(function () {
              copyBtn.classList.remove('copied');
              if (iconLink) iconLink.style.display = 'block';
              if (iconCheck) iconCheck.style.display = 'none';
            }, 2000);
          });
        }
      });
    }
  })();
</script>

