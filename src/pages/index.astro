---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import GeoDirectAnswer from '../components/GeoDirectAnswer.astro';
import { COLLECTIONS } from '../data/collections';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../i18n/utils';
import { localizeCollectionContent, localizeInsightMeta } from '../i18n/insightAndCollectionLocalization';
import { getLocalizedPageFaqs } from '../i18n/pageContentLocalization';
import { localizeTitle } from '../i18n/productLocalization';

const currentLang = getLanguageFromURL(Astro.url.pathname);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const allProducts = await getCollection('products');
const sortedProducts = allProducts.sort((a, b) => a.data.rowId - b.data.rowId);
const allGuides = await getCollection('insights');

const priorityGuideSlugs = [
  'hard-enamel-vs-soft-enamel-pins-wholesale-cost-durability-guide',
  'custom-marathon-and-5k-10k-finisher-medals-race-director-sourcing-guide',
  'custom-military-and-law-enforcement-challenge-coins-sizing-edge-guide',
  'european-trolley-coin-keyrings-1-euro-vs-12-sided-uk-pound-specs',
  'custom-3d-curved-police-security-and-fire-department-badges-guide',
  'custom-mold-tooling-fees-explained-how-to-get-zero-mold-fee-wholesale',
  'electroplating-finishes-guide-antique-brass-real-gold-black-nickel-pvd',
  'custom-enamel-and-3d-cufflinks-tie-bars-executive-menswear-gift-sets',
  'custom-golf-divot-repair-tools-and-magnetic-hat-clip-ball-markers-guide',
  'custom-metal-fridge-magnets-3d-zinc-vs-hard-soft-enamel-epoxy-guide',
  'custom-embroidered-patches-vs-woven-and-3d-soft-pvc-morale-patches',
  'cpsia-lead-free-en71-reach-nickel-free-electroplating-metal-craft-compliance',
  'china-direct-custom-pins-and-medals-manufacturing-lead-times-ddp-air-shipping'
];
const featuredCrawlGuides = priorityGuideSlugs
  .map((slug) => allGuides.find((g) => g.data.slug === slug))
  .filter(Boolean);

const priorityCrawlProducts = sortedProducts
  .filter((p) => p.data.rowId % 5 === 1)
  .slice(0, 30);

const primaryCollections = COLLECTIONS.filter((c) => c.group === 'primary');
const crossCollections = COLLECTIONS.filter((c) => c.group === 'cross');

// Section 1: Flagship Custom Lapel Pins (Collection #1)
const logoFeatured = sortedProducts
  .filter((p) => p.data.primaryCollection === 'custom-enamel-pins')
  .slice(0, 8);

// Section 4: Featured 3D Race & Marathon Medals (Collection #2)
const tuningForkProducts = sortedProducts
  .filter((p) => p.data.primaryCollection === 'custom-medals')
  .slice(0, 8);

// Section 5: Featured Challenge Coins & Trolley Tokens (Collections #3 & #5)
const exoticFeatured = sortedProducts
  .filter((p) => ['custom-challenge-coins', 'trolley-coin-keyrings'].includes(p.data.primaryCollection))
  .filter((_, idx) => idx % 4 === 0)
  .slice(0, 8);

const homeFaqs = [
  {
    question: 'What are the custom die and casting mold fees, and when are they waived?',
    answer: 'Custom 2D stamped lapel pin, keychain, and trolley coin dies cost $45–$85 (waived automatically at 500+ pcs per design), and 3D sculpted medal, challenge coin, or buckle molds cost $95–$150 (waived at 1,000+ pcs). Every paid custom steel die is archived free for 3 years for zero-fee reorders.'
  },
  {
    question: 'Do you keep pre-made inventory, or how are your 158 custom craft styles organized?',
    answer: 'Every pin, medal, challenge coin, badge, and keychain is 100% custom-tooled from your own logo or vector artwork—never stocked pre-made inventory. Our directory organizes 158 custom manufacturing specifications across 6 Primary Craft Hubs (Custom Enamel Pins, Custom Race Medals, Challenge Coins, Metal Keychains, €1/£1 Trolley Coins, and Police/Military Insignia) and 5 Specialty Lines (Executive Cufflinks & Buckles, Golf Tools, Bookmarks/Openers/Souvenirs, Patches/PVC/Boxes, and Custom Metal Fridge Magnets).'
  },
  {
    question: 'How fast can I receive a digital proof and pre-production physical sample?',
    answer: 'Send your vector logo or rough sketch via /contact or WhatsApp and receive a scaled 1:1 Pantone color & die-line digital proof completely free within 12 hours. Optional paid physical pre-production sample strikes finish in 7–10 business days via DHL/FedEx.'
  },
  {
    question: 'Should we choose Cloisonne Hard Enamel, Die-Struck Soft Enamel, or 3D Zinc Die-Casting?',
    answer: 'Select Cloisonne Hard Enamel for jewelry-grade smooth flush surfaces ($0.28–$1.85/pc), Die-Struck Soft Enamel for crisp raised metal ridges framing vivid recessed Pantone fills at 15%–25% lower unit cost, or 3D Zinc Die-Casting for contoured race medals, police shields, and heavyweight belt buckles.'
  },
  {
    question: 'What is the Minimum Order Quantity (MOQ) per custom design?',
    answer: 'Custom enamel pins and race medals require 300 pcs MOQ per design to amortize press, electroplating rack, and Pantone ink setup economically. Challenge coins, police shields, and cufflinks start at 50–100 pcs MOQ, while keychains, fridge magnets, and €1/£1 trolley coins start at 100–200 pcs MOQ with volume breaks at 500 and 2,000+ pcs.'
  },
  {
    question: 'Do your European Trolley Coin Keyrings fit both €1 Euro and UK 12-sided £1 supermarket locks?',
    answer: 'Yes. We strike dedicated Euro €1 coins at exact mint geometry (23.25mm diameter × 2.33mm thickness) and UK 12-sided £1 tokens (23.43mm across flats × 2.80mm thickness) in die-struck iron, solid brass, or zinc alloy with swivel lobster clasps and detachable magnetic frames.'
  },
  {
    question: 'Are your alloys, enamel colors, and electroplatings safe for US CPSIA and EU REACH imports?',
    answer: 'Yes. We pour certified lead-free Zamak #3 zinc ingots (<0.005% Pb), C26800 brass, non-phthalate Pantone enamels and PVC resins, plus optional nickel-free rack plating compliant with US CPSIA (<90 ppm lead), California Prop 65, EU EN71-3, and EN 1811 standards.'
  },
  {
    question: 'What packaging upgrades are available beyond individual polybags?',
    answer: 'Every pin, medal, coin, and keychain ships individually polybagged at $0.00 extra cost. Optional upgrades include 400gsm matte or foil-stamped retail pin backing cards (+$0.12–$0.22/pc), crystal-clear 38–60mm acrylic coin capsules (+$0.15–$0.35/pc), and hinged velvet gift boxes (+$0.85–$1.85/pc).'
  },
  {
    question: 'What are standard production lead times and international DDP delivery speeds?',
    answer: 'Mass production completes in 7–12 business days for stamped pins, coins, and trolley tokens and 10–15 business days for 3D sculpted medals or heavy buckles. Express air courier (DHL/FedEx DDP door-to-door) delivers globally in 5–7 business days directly from Guangdong.'
  },
  {
    question: 'What payment methods do wholesale buyers and organizations use?',
    answer: 'We accept T/T Bank Wire, corporate Wise transfers, Credit Card, and PayPal, with high-resolution pre-shipment batch photos and packing lists provided prior to dispatch.'
  }
];

const localizedHomeFaqs = getLocalizedPageFaqs('home', homeFaqs, currentLang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedHomeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const homeItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${t('home.hero.title')} | MedalPinSupply.com`,
  numberOfItems: COLLECTIONS.length,
  itemListElement: COLLECTIONS.map((col, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `https://medalpinsupply.com${getLocalizedPath(`/collections/${col.slug}`, currentLang)}`,
    name: t(`col.${col.slug}.name` as any)
  }))
};

const HOME_META_DESC_MAP: Record<string, string> = {
  en: 'Factory-direct custom enamel pins, 3D marathon medals, challenge coins & €1 trolley coins: 158 styles ($0.14–$6.95, MOQ 50–300). 12h free proof.',
  de: 'Pins, 3D-Laufmedaillen, Challenge Coins & Einkaufswagenchips ab Werk: 158 Stile ($0,14–$6,95, MOQ 50–300). 12h Gratis-Entwurf & Formkosten-Erlass.',
  fr: 'Pins émaillés, médailles 3D, pièces Challenge & jetons caddie 1€ : 158 styles sur mesure ($0,14–$6,95, MOQ 50–300). BAT gratuit 12h.',
  nl: 'Maatwerk emaille pins, 3D marathonmedailles, challenge coins & €1 munten: 158 stijlen ($0,14–$6,95, MOQ 50–300). Gratis 12u proef.',
  es: 'Fábrica de pines esmaltados, medallas 3D, monedas Challenge y fichas €1: 158 estilos a medida ($0.14–$6.95, MOQ 50–300). Prueba gratis 12h.',
  it: 'Fabbrica spille smaltate, medaglie 3D, monete Challenge e gettoni €1: 158 stili su misura ($0,14–$6,95, MOQ 50–300). Bozza gratuita 12h.',
  pt: 'Fábrica de broches esmaltados, medalhas 3D, moedas Challenge e fichas €1: 158 estilos sob medida ($0.14–$6.95, MOQ 50–300). Prova grátis 12h.',
  sv: 'Emaljpins, 3D-maratonmedaljer, challenge coins & €1 polletter direkt från fabrik: 158 stilar ($0.14–$6.95, MOQ 50–300). Fri skiss 12h.',
  da: 'Emaljepins, 3D-maratonmedaljer, challenge coins & €1 poletter fra fabrik: 158 stilarter ($0.14–$6.95, MOQ 50–300). Gratis udkast på 12t.',
  no: 'Emaljepins, 3D-maratonmedaljer, challenge coins & handlevognmynter: 158 stiler ($0.14–$6.95, MOQ 50–300). Gratis skisse på 12t.',
  fi: 'Emalipinssit, 3D-maratonmitalit, challenge-kolikot & ostospoletit tehtaalta: 158 tyyliä ($0.14–$6.95, MOQ 50–300). Ilmainen vedos 12h.',
  pl: 'Przypinki emaliowane, medale 3D, monety Challenge i żetony €1 prosto z fabryki: 158 stylów ($0.14–$6.95, MOQ 50–300). Projekt 12h gratis.',
  cs: 'Smaltované odznaky, 3D maratonské medaile, challenge mince a žetony €1 z továrny: 158 stylů ($0.14–$6.95, MOQ 50–300). Náhled 12h zdarma.',
  ru: 'Значки с эмалью, 3D-медали, монеты Challenge Coins и жетоны €1 с завода: 158 форматов ($0.14–$6.95, MOQ 50–300). Бесплатный макет 12 ч.',
  ja: 'カスタムピンバッジ・3Dマラソンメダル・チャレンジコイン・€1カートコイン直営工場：全158仕様($0.14〜$6.95、MOQ 50〜300個、12h無料校正)。',
  ko: '커스텀 에나멜 핀, 3D 마라톤 메달, 챌린지 코인 & €1 트롤리 코인 직영 공장: 전 158종 ($0.14–$6.95, MOQ 50~300개). 12시간 무료 시안.',
  id: 'Pabrik pin enamel, medali maraton 3D, koin challenge & koin troli €1: 158 gaya kustom ($0,14–$6,95, MOQ 50–300). Desain gratis 12 jam.',
  ar: 'مصنع دبابيس المينا والميداليات ثلاثية الأبعاد وعملات التحدي وعملات التسوق: 158 نمطاً مخصصاً ($0.14–$6.95، الحد الأدنى 50–300). تصميم مجاني.'
};
---

<Layout
  title={currentLang === 'en' ? 'Custom Enamel Pins, Medals & Coins Factory ($0.11+)' : `${t('home.hero.title')} | MedalPinSupply.com`}
  description={HOME_META_DESC_MAP[currentLang] || t('home.hero.lead')}
  preloadImage="/images/hero-medal-pin-showcase.webp"
  activePage="home"
  jsonLd={[homeItemListSchema, faqSchema]}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-badges">
          <span class="badge badge-dark">{t('home.hero.badge1')}</span>
          <span class="badge badge-gold">{t('home.hero.badge2')}</span>
        </div>
        <h1 class="hero-title">
          {t('home.hero.title')}<br />
          <span>{t('home.hero.titleHighlight')}</span>
        </h1>
        <p class="hero-lead">
          {t('home.hero.lead')}
        </p>

        <div class="hero-kpis">
          <div class="kpi-item">
            <strong>{t('home.hero.kpi1Val')}</strong>
            <span>{t('home.hero.kpi1Sub')}</span>
          </div>
          <div class="kpi-item">
            <strong>{t('home.hero.kpi2Val')}</strong>
            <span>{t('home.hero.kpi2Sub')}</span>
          </div>
          <div class="kpi-item">
            <strong>{t('home.hero.kpi3Val')}</strong>
            <span>{t('home.hero.kpi3Sub')}</span>
          </div>
          <div class="kpi-item">
            <strong>{t('home.hero.kpi4Val')}</strong>
            <span>{t('home.hero.kpi4Sub')}</span>
          </div>
        </div>

        <div class="hero-ctas">
          <a href={getLocalizedPath('/collections/custom-enamel-pins', currentLang)} class="btn btn-accent">
            {t('home.hero.ctaLogo')}
          </a>
          <a href={getLocalizedPath('/products', currentLang)} class="btn btn-primary">
            {t('home.hero.ctaCatalog')}
          </a>
        </div>

        <div class="hero-col-pills">
          {COLLECTIONS.slice(0, 6).map((col) => (
            <a href={getLocalizedPath(`/collections/${col.slug}`, currentLang)} class="hero-col-pill">
              <span>{t(`col.${col.slug}.short` as any)}</span>
              <strong>{col.skuCount}</strong>
            </a>
          ))}
          <a
            href={getLocalizedPath('/contact', currentLang)}
            class="hero-col-pill"
            data-rfq-sku="Custom Enamel Pins, 3D Marathon Medals & Challenge Coins"
            data-rfq-mode="Free 12h Digital Artwork Proof"
            data-rfq-qty="100"
          >
            <span>🎨 12h Proof</span>
            <strong>Free Art</strong>
          </a>
          <a
            href={getLocalizedPath('/contact', currentLang)}
            class="hero-col-pill"
            data-rfq-sku="All 158 Custom Craft Styles (Price Guide)"
            data-rfq-mode="Standard Enamel / Die-Cast"
            data-rfq-qty="500"
          >
            <span>{microHooks.sheet140}</span>
            <strong>PDF</strong>
          </a>
        </div>
      </div>

      <div class="hero-showcase">
        <div class="showcase-card">
          <div class="showcase-top">
            <span class="sku-pill">{t('home.hero.showcasePill')}</span>
            <span class="showcase-price">$0.14 – $6.95<span>/{t('unit.pc')}</span></span>
          </div>
          <img
            src="/images/hero-medal-pin-showcase.webp"
            alt="Custom Cloisonne Hard Enamel Pins, 3D Sculpted Marathon Finisher Medals, Challenge Coins, and Euro Trolley Tokens by MedalPinSupply"
            width="480"
            height="360"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="showcase-img"
          />
          <div class="showcase-meta">
            <strong>{t('home.hero.showcaseTitle')}</strong>
            <p>{t('home.hero.showcaseDesc')}</p>
            <div class="showcase-links">
              <a href={getLocalizedPath('/collections/custom-enamel-pins', currentLang)}>{t('home.hero.showcaseLink1')}</a>
              <a href={getLocalizedPath('/contact', currentLang)}>{t('card.quoteSku')} →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Supply Chain Specification Summary -->
  <div class="container">
    <GeoDirectAnswer
      title={t('home.geo.title')}
      answer={t('home.geo.answer')}
    />

    <form class="inline-quick-sheet-form" data-inline-sku="Custom Medal, Pin & Coin Craft Styles ($0.14–$6.95 · Price Guide & 12h Proof)" novalidate>
      <div class="inline-qrfq-text">
        <strong>{microHooks.getFullSheetPdf}</strong>
        <span>{microHooks.mixMoqBadge}</span>
      </div>
      <div class="inline-qrfq-controls">
        <input
          type="email"
          class="inline-qrfq-input"
          placeholder={`${t('contact.workEmail')} (name@company.com)`}
          aria-label={t('contact.workEmail')}
          required
        />
        <button type="submit" class="inline-qrfq-btn">
          ⚡ {microHooks.sheet140} →
        </button>
      </div>
      <div class="inline-qrfq-status" hidden></div>
    </form>
  </div>

  <!-- Section 1: Featured 2D Die-Struck & Enamel Custom Craft Models (Immediate Visual SKU Grid) -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header-center">
        <span class="badge badge-emerald">{t('home.section3.badge')}</span>
        <h2 class="section-title">{t('home.section3.title')}</h2>
        <p class="section-subtitle">
          {t('home.section3.sub')}
        </p>
      </div>

      <div class="quick-cat-bar">
        {primaryCollections.map((col) => (
          <a href={getLocalizedPath(`/collections/${col.slug}`, currentLang)} class="quick-cat-pill">
            <span>{t(`col.${col.slug}.short` as any)}</span>
            <strong>{col.skuCount}</strong>
          </a>
        ))}
        <a href={getLocalizedPath('/custom-branding', currentLang)} class="quick-cat-pill quick-cat-pill-gold">
          <span>★ {t('nav.customLogo')}</span>
          <strong>500+ Die Free</strong>
        </a>
      </div>

      <div class="grid-4">
        {logoFeatured.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="section-cta-row">
        <a href={getLocalizedPath('/collections/custom-enamel-pins', currentLang)} class="btn btn-primary">
          {t('home.section3.cta')}
        </a>
        <a href={getLocalizedPath('/products', currentLang)} class="btn btn-outline">
          {t('home.hero.ctaCatalog')} →
        </a>
      </div>
    </div>
  </section>

  <!-- Section 2: 6 Primary Category Collections (with 3-SKU Visual Previews) -->
  <section class="section">
    <div class="container">
      <div class="section-header-center">
        <span class="badge">{t('home.section1.badge')}</span>
        <h2 class="section-title">{t('home.section1.title')}</h2>
        <p class="section-subtitle">
          {t('home.section1.sub')}
        </p>
      </div>

      <div class="grid-3">
        {primaryCollections.map((col) => {
          const locCol = localizeCollectionContent(col, currentLang);
          const previewSkus = sortedProducts
            .filter((p) => p.data.primaryCollection === col.slug)
            .slice(0, 3);
          return (
            <a href={getLocalizedPath(`/collections/${col.slug}`, currentLang)} class="collection-card">
              <div class="col-card-top">
                <span class="col-num">{t('home.section1.catPrefix')} 0{col.number}</span>
                <span class="col-count">{col.skuCount} {t('home.section1.readyMolds')}</span>
              </div>
              <h3 class="col-title">{t(`col.${col.slug}.name` as any)}</h3>
              <p class="col-zh">{t(`col.${col.slug}.short` as any)} · {col.priceRangeUsd}</p>
              {previewSkus.length > 0 && (
                <div class="col-thumb-strip">
                  {previewSkus.map((sku) => (
                    <div class="col-thumb-item">
                      <img
                        src={sku.data.featuredImage}
                        alt={localizeTitle(sku.data.title, currentLang)}
                        width="88"
                        height="66"
                        loading="lazy"
                        decoding="async"
                      />
                      <span>${sku.data.tier2000}+</span>
                    </div>
                  ))}
                </div>
              )}
              <p class="col-desc">{locCol.heroSubtitle}</p>
              <div class="col-footer">
                <span>MOQ: {locCol.moq}</span>
                <span class="col-cta">{col.skuCount} {t('home.section1.exploreModels')}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Section 3: 3 High-Converting Cross-Tag Collections -->
  <section class="section section-dark">
    <div class="container">
      <div class="section-header-center">
        <span class="badge badge-gold">{t('home.section2.badge')}</span>
        <h2 class="section-title">{t('home.section2.title')}</h2>
        <p class="section-subtitle" style="color: #cbd5e1;">
          {t('home.section2.sub')}
        </p>
      </div>

      <div class="grid-3">
        {crossCollections.map((col) => {
          const locCol = localizeCollectionContent(col, currentLang);
          return (
            <div class="cross-card">
              <div class="cross-badge">{t(`col.${col.slug}.short` as any)}</div>
              <h3>{t(`col.${col.slug}.name` as any)}</h3>
              <p class="cross-zh">{t(`col.${col.slug}.short` as any)} · {col.priceRangeUsd}</p>
              <p class="cross-desc">{locCol.heroSubtitle}</p>
              <ul class="cross-highlights">
                {locCol.engineeringHighlights.map((h: string) => (
                  <li>✓ {h}</li>
                ))}
              </ul>
              <a href={getLocalizedPath(`/collections/${col.slug}`, currentLang)} class="btn btn-accent" style="width: 100%; margin-top: auto;">
                {col.skuCount} {t('home.section2.browseAll')}
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Section 4: Acoustic Tuning Fork Series (All 7 Models) -->
  <section class="section">
    <div class="container">
      <div class="section-header-center">
        <span class="badge">{t('home.section4.badge')}</span>
        <h2 class="section-title">{t('home.section4.title')}</h2>
        <p class="section-subtitle">
          {t('home.section4.sub')}
        </p>
      </div>

      <div class="grid-4">
        {tuningForkProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: Multi-Material Supply Chain Ladder Case Study -->
  <section class="section section-light">
    <div class="container">
      <div class="section-header-center">
        <span class="badge">{t('home.section5.badge')}</span>
        <h2 class="section-title">{t('home.section5.title')}</h2>
        <p class="section-subtitle">
          {t('home.section5.sub')}
        </p>
      </div>

      <div class="grid-4">
        {exoticFeatured.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="home-crawl-hub-card">
        <div class="crawl-hub-block">
          <div class="crawl-hub-head">
            <span class="badge">{t('nav.guides')}</span>
            <h3>{t('guide.relatedGuidesTitle')}</h3>
          </div>
          <div class="crawl-guides-grid">
            {featuredCrawlGuides.map((g: any) => {
              const gLoc = localizeInsightMeta(g.data, currentLang);
              return (
                <a href={getLocalizedPath(`/insights/${g.data.slug}`, currentLang)} class="crawl-guide-link">
                  <span class="crawl-guide-cat">{gLoc.category}</span>
                  <strong>{gLoc.title}</strong>
                </a>
              );
            })}
          </div>
        </div>

        <div class="crawl-hub-divider"></div>

        <div class="crawl-hub-block">
          <div class="crawl-hub-head crawl-hub-head-split">
            <div class="crawl-hub-head-left">
              <span class="badge">{t('nav.allCatalog')}</span>
              <h3>{t('guide.refModelsTitle')}</h3>
            </div>
            <a href={getLocalizedPath('/wholesale-catalog', currentLang)} class="crawl-hub-all-link">
              {t('home.hero.ctaCatalog')} →
            </a>
          </div>
