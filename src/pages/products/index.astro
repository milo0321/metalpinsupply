---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { COLLECTIONS } from '../../data/collections';
import { getLanguageFromURL, getLocalizedPath, useTranslations, getMicroHookLabels } from '../../i18n/utils';
import { getLocalizedPageFaqs } from '../../i18n/pageContentLocalization';
import { localizeTitle } from '../../i18n/productLocalization';

const currentLang = getLanguageFromURL(Astro.url.pathname);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const allProducts = await getCollection('products');
const sortedProducts = allProducts.sort((a, b) => a.data.rowId - b.data.rowId);
const primaryCollections = COLLECTIONS.filter((c) => c.group === 'primary');

const catalogFaqs = [
  {
    question: 'Are these stock items, or is every order custom-molded to client artwork?',
    answer: 'Every pin, race medal, challenge coin, badge, and trolley coin is 100% custom-tooled from your vector artwork or logo—we never sell off-the-shelf inventory or pre-made templates. The 158 craft configurations across 11 collections showcase available metals, processes, thicknesses, and attachments.'
  },
  {
    question: 'How do custom die and casting mold fees work, and when are they waived?',
    answer: 'Custom 2D stamped lapel pin and trolley coin dies cost $45–$85 USD (waived automatically at 500+ pcs per design), while 3D zinc die-cast medal, challenge coin, and buckle molds cost $95–$150 USD (waived at 1,000+ pcs). Every paid custom steel die is stored free for 3 years for $0 reorders.'
  },
  {
    question: 'How can I filter between 2D Die-Struck, Hard/Soft Enamel crafts, and 3D Die-Cast items?',
    answer: 'Use the "Craft Category" dropdown above to filter instantaneously by 🔨 2D Die-Struck & Stamped, 🎨 Hard / Soft Enamel Crafts, or 🔩 3D Sculpted Die-Cast formats, alongside material metallurgy, 2,000+ pcs USD pricing tiers, and gram weight.'
  },
  {
    question: 'Should I choose Cloisonne Hard Enamel, Soft Enamel, Photo-Etched Brass, or 3D Zinc?',
    answer: 'Choose Cloisonne Hard Enamel for glass-smooth flush borders, Die-Struck Soft Enamel for vivid textured relief at 15%–25% lower cost, Photo-Etched Brass or CMYK Offset for fine hairlines and photographic gradients, or Zamak #3 Zinc Alloy Die-Casting for multi-level sculpted 3D medals, badges, and keychains.'
  },
  {
    question: 'Can I receive a free digital proof before confirming tooling or production?',
    answer: 'Yes. Submit your vector logo (.AI, .EPS, .PDF, .SVG) or sketch via /contact or WhatsApp (+86 187 5012 6315) and receive a free scaled 1:1 Pantone color & die-line production proof within 12 hours.'
  },
  {
    question: 'Can we mix finishes or combine multiple custom items into one consolidated shipment?',
    answer: 'Yes. Our Zhongshan Xiaolan foundry consolidates custom pins, race medals, challenge coins, trolley tokens, backing cards, and velvet boxes into a single QC-inspected air express (DHL/FedEx DDP) or ocean freight shipment.'
  },
  {
    question: 'What do the starter MOQ (100–300–499 pcs), 500–1,999 pcs, and 2,000+ pcs USD price tiers include?',
    answer: 'Published USD wholesale tiers cover the custom stamped or cast unit, standard electroplating, up to 4–5 Pantone enamel colors, standard attachment hardware (butterfly clutch, split ring, or standard satin neck ribbon), 100% cosmetic QC, and individual OPP polybag packing. Custom pins & medals start at 300 pcs MOQ (300–499 starter tier).'
  },
  {
    question: 'How fast are pre-production physical samples and bulk manufacturing turnaround?',
    answer: 'Optional paid physical pre-production samples ship in 7–10 business days via air courier. Full bulk batches complete in 7–12 business days for stamped pins and coins and 10–15 business days for 3D die-cast medals and buckles.'
  },
  {
    question: 'Are your alloys, enamel colors, and platings compliant with US CPSIA and EU REACH?',
    answer: 'Yes. We pour certified lead-free Zamak #3 (<0.005% Pb) and C26800 brass using phthalate-free Pantone enamels and nickel-safe rack plating compliant with US CPSIA (<90 ppm lead), CA Prop 65, EU EN71-3, and EN 1811.'
  },
  {
    question: 'Do your €1 and UK £1 trolley coins match real supermarket cart locks?',
    answer: 'Yes. Euro €1 tokens are stamped to exact 23.25mm × 2.33mm specs and UK 12-sided £1 tokens to 23.43mm × 2.80mm tolerances for instant release across Aldi, Lidl, Tesco, Carrefour, and European grocery locks.'
  }
];

const localizedCatalogFaqs = getLocalizedPageFaqs('catalog', catalogFaqs, currentLang);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: localizedCatalogFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const catalogCollectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${t('catalog.title')} | MedalPinSupply.com`,
  url: `https://medalpinsupply.com${getLocalizedPath('/products', currentLang)}`,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '0.14',
    highPrice: '6.95',
    offerCount: sortedProducts.length
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: sortedProducts.length,
    itemListElement: sortedProducts.slice(0, 30).map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `https://medalpinsupply.com${getLocalizedPath(`/products/${p.data.slug}`, currentLang)}`,
      name: localizeTitle(p.data.title, currentLang),
      image: `https://medalpinsupply.com${p.data.featuredImage}`
    }))
  }
};

const CATALOG_META_DESC_MAP: Record<string, string> = {
  en: '158 custom-tooled enamel pin, 3D marathon medal, challenge coin & €1 trolley coin styles ($0.14–$6.95, MOQ 50–300). 12h free proof.',
  de: '158 maßgefertigte Pins, 3D-Laufmedaillen, Challenge Coins & Einkaufswagenchips ($0,14–$6,95, MOQ 50–300 Stk.). 12h Gratis-Entwurf.',
  fr: '158 créations sur mesure : pins émaillés, médailles 3D, pièces Challenge & jetons 1€ ($0,14–$6,95, MOQ 50–300). BAT 12h gratuit.',
  nl: '158 maatwerkopties: emaille pins, 3D marathonmedailles, challenge coins & €1 munten ($0,14–$6,95, MOQ 50–300). Gratis 12u proef.',
  es: '158 estilos a medida: pines esmaltados, medallas 3D, monedas Challenge y fichas €1 ($0.14–$6.95, MOQ 50–300). Prueba 12h gratis.',
  it: '158 stili su misura: spille smaltate, medaglie 3D, monete Challenge e gettoni €1 ($0,14–$6,95, MOQ 50–300). Bozza gratuita 12h.',
  pt: '158 opções sob medida: broches esmaltados, medalhas 3D, moedas Challenge e fichas €1 ($0.14–$6.95, MOQ 50–300). Prova 12h grátis.',
  sv: '158 kundanpassade stilar: emaljpins, 3D-maratonmedaljer, challenge coins & €1 polletter ($0.14–$6.95, MOQ 50–300). Fri skiss 12h.',
  da: '158 tilpassede stilarter: emaljepins, 3D-medaljer, challenge coins & €1 poletter ($0.14–$6.95, MOQ 50–300). Gratis udkast 12t.',
  no: '158 spesialtilpassede stiler: emaljepins, 3D-medaljer, challenge coins & handlevognmynter ($0.14–$6.95, MOQ 50–300). Gratis skisse 12t.',
  fi: '158 räätälöityä tyyliä: emalipinssit, 3D-mitalit, challenge-kolikot & ostospoletit ($0.14–$6.95, MOQ 50–300 kpl). Ilmainen 12h vedos.',
  pl: '158 stylów na zamówienie: przypinki emaliowane, medale 3D, monety Challenge i żetony €1 ($0.14–$6.95, MOQ 50–300). Projekt 12h.',
  cs: '158 zakázkových stylů: smaltované odznaky, 3D medaile, challenge mince a žetony €1 ($0.14–$6.95, MOQ 50–300). Náhled 12h zdarma.',
  ru: '158 видов на заказ: значки с эмалью, 3D-медали, монеты Challenge и жетоны €1 ($0.14–$6.95, MOQ 50–300). Макет за 12 ч бесплатно.',
  ja: 'オーダーメイドピンズ・3Dメダル・チャレンジコイン・€1カートコイン全158仕様（$0.14〜$6.95、MOQ 50〜300個、12h無料校正）。',
  ko: '주문 제작 에나멜 핀, 3D 마라톤 메달, 챌린지 코인 & €1 트롤리 코인 전 158종 ($0.14–$6.95, MOQ 50~300개). 12시간 무료 시안.',
  id: '158 gaya kustom pabrik: pin enamel, medali 3D, koin challenge & koin troli €1 ($0,14–$6,95, MOQ 50–300). Desain gratis 12 jam.',
  ar: '158 خيار تصنيع مخصص: دبابيس المينا، ميداليات 3D، عملات التحدي وعملات التسوق ($0.14–$6.95، الحد الأدنى 50–300). تصميم مجاني.'
};
---

<Layout
  title={currentLang === 'en' ? '158 Custom Pins, Medals & Challenge Coins ($0.11+)' : `${t('catalog.title')} (158 · $0.11+) | MedalPinSupply`}
  description={CATALOG_META_DESC_MAP[currentLang] || t('catalog.desc')}
  activePage="products"
  jsonLd={[catalogCollectionSchema, faqSchema]}
>
  <section class="grand-hero">
    <div class="container grand-hero-centered">
      <nav class="hero-breadcrumb" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">{t('breadcrumb.allCatalog')}</span>
      </nav>

      <div class="hero-badges-row">
        <span class="badge badge-dark">{t('catalog.badge')}</span>
        <span class="badge badge-gold">{t('home.hero.badge2')}</span>
      </div>

      <h1 class="grand-hero-title">{t('catalog.title')}</h1>
      <p class="grand-hero-lead">
        {t('catalog.desc')}
      </p>

      <div class="hero-glass-grid">
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('col.stat1Label')}</span>
          <strong class="glass-kpi-val">158</strong>
        </div>
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('home.hero.kpi2Sub')}</span>
          <strong class="glass-kpi-val">500+ Waived</strong>
        </div>
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('col.stat3Label')}</span>
          <strong class="glass-kpi-val">50–300 {t('unit.pcs')}</strong>
        </div>
        <div class="glass-kpi-card">
          <span class="glass-kpi-label">{t('col.stat2Label')}</span>
          <strong class="glass-kpi-val">$0.14 – $6.95</strong>
        </div>
      </div>

      <div class="hero-actions">
        <a
          href={getLocalizedPath('/contact', currentLang)}
          data-rfq-sku="Custom Medal, Pin & Coin Quote Request (Full Price Guide)"
          data-rfq-mode="Custom Enamel / Cast Spec"
          data-rfq-qty="300"
          class="btn btn-accent btn-hero"
        >
          ⚡ {t('nav.requestQuote')}
        </a>
        <a href={getLocalizedPath('/collections/custom-enamel-pins', currentLang)} class="btn btn-secondary-dark btn-hero">
          {t('home.hero.ctaLogo')}
        </a>
      </div>

      <div class="hero-badges-row" style="margin-top: 1rem;">
        <a
          href={getLocalizedPath('/contact', currentLang)}
          data-rfq-sku="Custom Pin, Medal & Coin Price Matrix (PDF / Excel)"
          data-rfq-mode="Standard Enamel / Die-Cast"
          data-rfq-qty="500"
          class="badge badge-gold"
          style="text-decoration: none;"
        >
          {microHooks.getFullSheetPdf}
        </a>
        <a
          href={getLocalizedPath('/contact', currentLang)}
          data-rfq-sku="Hard Enamel Pins, 3D Marathon Medals & Challenge Coins"
          data-rfq-mode="Free 12h Digital Artwork Proof"
          data-rfq-qty="300"
          class="badge badge-dark"
          style="text-decoration: none;"
        >
          {microHooks.sample1Pc} ({microHooks.freeLogoProof}) →
        </a>
        <a
          href={getLocalizedPath('/insights/hard-enamel-vs-soft-enamel-pins-wholesale-cost-durability-guide', currentLang)}
          class="badge badge-dark"
          style="text-decoration: none;"
        >
          📖 Hard vs. Soft Enamel Pin Guide →
        </a>
      </div>
    </div>
  </section>

  <div class="container">
    <GeoDirectAnswer
      title={t('catalog.geoTitle')}
      answer={t('catalog.geoAnswer')}
    />

    <form class="inline-quick-sheet-form" data-inline-sku="Custom Pin, Medal & Coin Wholesale Price Guide (PDF / Excel)" novalidate>
      <div class="inline-qrfq-text">
        <strong>{microHooks.getFullSheetPdf}</strong>
        <span>{microHooks.mixMoqBadge}</span>
      </div>
      <div class="inline-qrfq-controls">
        <input
          type="email"
          class="inline-qrfq-input"
          placeholder={`${t('contact.workEmail')} (name@company.com)`}
          aria-label={t('contact.workEmail')}
          required
        />
        <button type="submit" class="inline-qrfq-btn">
          ⚡ {microHooks.sheet140} →
        </button>
      </div>
      <div class="inline-qrfq-status" hidden>✓ Sent! Check your inbox shortly.</div>
    </form>

    <!-- Instant Filter Toolbar -->
    <div class="filter-panel">
      <div class="filter-row">
        <div class="filter-group filter-search">
          <label for="catalog-search">{t('catalog.searchLabel')}</label>
          <input
            type="search"
            id="catalog-search"
            placeholder={t('catalog.searchPlaceholder')}
          />
        </div>

        <div class="filter-group">
          <label for="filter-category">{t('catalog.categoryLabel')}</label>
          <select id="filter-category">
            <option value="all">{t('catalog.allCategories')}</option>
            {COLLECTIONS.map((c) => (
              <option value={c.slug}>{t(`col.${c.slug}.short` as any)} ({c.skuCount})</option>
            ))}
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-tag">{t('catalog.tagLabel')}</label>
          <select id="filter-tag">
            <option value="all">{t('catalog.allMolds')}</option>
            <option value="logo">{t('catalog.tagLogo')}</option>
            <option value="tuning">{t('catalog.tagTuning')}</option>
            <option value="cnc">{t('catalog.tagCnc')}</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-material">{t('catalog.materialLabel')}</label>
          <select id="filter-material">
            <option value="all">{t('catalog.allMaterials')}</option>
            <option value="zinc">{t('catalog.matZinc')}</option>
            <option value="stainless">{t('catalog.matStainless')}</option>
            <option value="aluminum">{t('catalog.matAluminum')}</option>
            <option value="exotic">{t('catalog.matExotic')}</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-price">{t('catalog.priceLabel')}</label>
          <select id="filter-price">
            <option value="all">{t('catalog.allPrices')}</option>
            <option value="under5">{t('catalog.priceUnder5')}</option>
            <option value="5to15">{t('catalog.price5to15')}</option>
            <option value="over15">{t('catalog.priceOver15')}</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-weight">{t('catalog.weightLabel')}</label>
          <select id="filter-weight">
            <option value="all">{t('catalog.allWeights')}</option>
            <option value="light">{t('catalog.weightLight')}</option>
            <option value="medium">{t('catalog.weightMedium')}</option>
            <option value="heavy">{t('catalog.weightHeavy')}</option>
          </select>
        </div>
      </div>

      <div class="filter-status-bar">
        <span><strong id="visible-count">{sortedProducts.length}</strong> / <strong>{sortedProducts.length}</strong> · {t('catalog.title')}</span>
        <button type="button" id="reset-filters" class="btn-reset">{t('catalog.resetFilters')}</button>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid-4 catalog-grid" id="catalog-grid">
      {sortedProducts.map((p) => (
        <ProductCard product={p} />
      ))}
    </div>

    <!-- Catalog FAQ Section -->
    <section class="section section-light catalog-faq-box">
      <div class="section-header-center">
        <span class="badge">{t('catalog.faqBadge')}</span>
        <h2 class="section-title">{t('catalog.faqTitle')}</h2>
      </div>
      <div class="faq-list">
        {localizedCatalogFaqs.map((faq, idx) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (function () {
    const searchInput = document.getElementById('catalog-search');
    const catSelect = document.getElementById('filter-category');
    const tagSelect = document.getElementById('filter-tag');
    const matSelect = document.getElementById('filter-material');
    const priceSelect = document.getElementById('filter-price');
    const weightSelect = document.getElementById('filter-weight');
    const resetBtn = document.getElementById('reset-filters');
    const countEl = document.getElementById('visible-count');
    const cards = Array.from(document.querySelectorAll('#catalog-grid .product-card'));

    function applyFilters() {
      const q = (searchInput.value || '').trim().toLowerCase();
      const cat = catSelect.value;
      const tag = tagSelect.value;
      const mat = matSelect.value;
      const price = priceSelect.value;
      const weight = weightSelect.value;

      let shown = 0;
      cards.forEach((card) => {
        const sku = card.dataset.sku || '';
        const title = card.dataset.title || '';
        const zh = card.dataset.zh || '';
        const cCat = card.dataset.category || '';
        const cMat = card.dataset.material || '';
        const cLogo = card.dataset.logo === 'true';
        const cTuning = card.dataset.tuning === 'true';
        const cCnc = card.dataset.cnc === 'true';
        const cPrice = parseFloat(card.dataset.price || '0');
        const cWeight = parseFloat(card.dataset.weight || '75');

        let match = true;
        if (q && !(sku.includes(q) || title.includes(q) || zh.includes(q))) match = false;
        if (match && cat !== 'all' && cCat !== cat) match = false;
        if (match && tag !== 'all') {
          if (tag === 'logo' && !cLogo) match = false;
          if (tag === 'tuning' && !cTuning) match = false;
          if (tag === 'cnc' && !cCnc) match = false;
        }
        if (match && mat !== 'all') {
          if (mat === 'zinc' && !(cMat.includes('zinc') || cMat.includes('zamak'))) match = false;
          if (mat === 'stainless' && !(cMat.includes('brass') || cMat.includes('copper') || cMat.includes('bronze'))) match = false;
          if (mat === 'aluminum' && !(cMat.includes('iron') || cMat.includes('stainless') || cMat.includes('steel') || cMat.includes('aluminum'))) match = false;
          if (mat === 'exotic' && !(cMat.includes('pewter') || cMat.includes('pvc') || cMat.includes('leather') || cMat.includes('twill') || cMat.includes('felt') || cMat.includes('acrylic') || cMat.includes('velvet'))) match = false;
        }
        if (match && price !== 'all') {
          if (price === 'under5' && cPrice >= 0.50) match = false;
          if (price === '5to15' && (cPrice < 0.50 || cPrice > 1.50)) match = false;
          if (price === 'over15' && cPrice <= 1.50) match = false;
        }
        if (match && weight !== 'all') {
          if (weight === 'light' && cWeight >= 15) match = false;
          if (weight === 'medium' && (cWeight < 15 || cWeight > 55)) match = false;
          if (weight === 'heavy' && cWeight <= 55) match = false;
        }

        card.style.display = match ? '' : 'none';
        if (match) shown++;
      });

      if (countEl) countEl.textContent = String(shown);
    }

    [searchInput, catSelect, tagSelect, matSelect, priceSelect, weightSelect].forEach((el) => {
      if (el) el.addEventListener('input', applyFilters);
      if (el) el.addEventListener('change', applyFilters);
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        catSelect.value = 'all';
        tagSelect.value = 'all';
        matSelect.value = 'all';
        priceSelect.value = 'all';
        weightSelect.value = 'all';
        applyFilters();
      });
    }
  })();
</script>

<style>
  .catalog-hero {
    background: #0f172a;
    color: #ffffff;
    padding: 3.25rem 0;
    border-bottom: 1px solid #1e293b;
  }
  .catalog-hero h1 {
    color: #ffffff;
    font-size: clamp(1.85rem, 3.2vw, 2.65rem);
    margin: 0.75rem 0;
  }
  .catalog-hero p {
    color: #cbd5e1;
    max-width: 820px;
    font-size: 1.02rem;
  }
  .filter-panel {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 0.85rem;
    padding: 1.5rem;
    margin-bottom: 2.25rem;
    box-shadow: var(--shadow-sm);
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }
  .filter-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 1.25rem;
    width: 100%;
  }
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    max-width: 100%;
  }
  .filter-group label {
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #475569;
    letter-spacing: 0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .filter-group input,
  .filter-group select {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 0.65rem 0.85rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.5rem;
    font-size: 0.88rem;
    background: #ffffff;
    color: #0f172a;
    font-family: var(--font-body);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .filter-group input:focus,
  .filter-group select:focus {
    outline: none;
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);
  }
  .filter-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e2e8f0;
    font-size: 0.86rem;
    color: #334155;
  }
  .btn-reset {
    background: transparent;
    border: 1px solid #cbd5e1;
    padding: 0.35rem 0.8rem;
    border-radius: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #0284c7;
    cursor: pointer;
  }
  .btn-reset:hover {
    background: #e0f2fe;
  }
  .catalog-grid {
    padding-bottom: 4rem;
  }
  .catalog-faq-box {
    border-radius: 1rem;
    padding: 3rem 2rem;
    margin-bottom: 3.5rem;
  }
  @media (max-width: 960px) {
    .filter-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
