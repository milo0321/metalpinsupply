---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import GeoDirectAnswer from '../../components/GeoDirectAnswer.astro';
import { getLanguageFromURL, useTranslations, getLocalizedPath, getMicroHookLabels } from '../../i18n/utils';
import { localizeProduct, localizeTitle, getRelatedInsightSlugsForProduct } from '../../i18n/productLocalization';
import { localizeInsightMeta } from '../../i18n/insightAndCollectionLocalization';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const allGuides = await getCollection('insights');
  const sorted = products.sort((a, b) => a.data.rowId - b.data.rowId);

  return sorted.map((entry) => {
    const p = entry.data;
    const sameCol = sorted.filter((other) => other.data.primaryCollection === p.primaryCollection);
    const selfIdx = sameCol.findIndex((other) => other.data.slug === p.slug);
    const related: typeof sorted = [];
    if (sameCol.length > 1) {
      const count = Math.min(8, sameCol.length - 1);
      for (let offset = 1; offset <= count; offset++) {
        const step = offset <= 4 ? offset : offset * 2 - 3;
        const candidate = sameCol[(selfIdx + step) % sameCol.length];
        if (!related.some((r) => r.data.slug === candidate.data.slug) && candidate.data.slug !== p.slug) {
          related.push(candidate);
        } else {
          const fallback = sameCol[(selfIdx + offset) % sameCol.length];
          if (!related.some((r) => r.data.slug === fallback.data.slug) && fallback.data.slug !== p.slug) {
            related.push(fallback);
          }
        }
      }
    }

    const targetGuideSlugs = getRelatedInsightSlugsForProduct(p);
    const relatedGuides = targetGuideSlugs
      .map((s) => allGuides.find((g) => g.data.slug === s))
      .filter(Boolean)
      .slice(0, 6);

    return {
      params: { slug: p.slug },
      props: { product: p, relatedProducts: related, relatedGuides }
    };
  });
}

const { product: p, relatedProducts, relatedGuides = [] } = Astro.props;
const currentLang = getLanguageFromURL(Astro.url);
const t = useTranslations(currentLang);
const microHooks = getMicroHookLabels(currentLang);
const lp = localizeProduct(p, currentLang);
const rfqBaseUrl = getLocalizedPath('/contact', currentLang);

const allImages = p.galleryImages && p.galleryImages.length > 0 ? p.galleryImages : [p.featuredImage];

const allVariantPrices = [
  parseFloat(p.tier2000),
  parseFloat(p.tier500),
  parseFloat(p.tier100),
  ...(p.variants || []).flatMap((v: any) => [parseFloat(v.tier2000), parseFloat(v.tier500), parseFloat(v.tier100)])
].filter((n) => !isNaN(n) && n > 0);
const minOfferPrice = allVariantPrices.length ? Math.min(...allVariantPrices).toFixed(2) : p.tier2000;
const maxOfferPrice = allVariantPrices.length ? Math.max(...allVariantPrices).toFixed(2) : p.tier100;
const canonicalProductUrl = `https://medalpinsupply.com${getLocalizedPath(`/products/${p.slug}`, currentLang)}`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: lp.title,
  sku: p.sku,
  mpn: p.sku,
  image: allImages.map((img: string) => `https://medalpinsupply.com${img}`),
  description: lp.overview,
  brand: {
    '@type': 'Brand',
    name: 'MedalPinSupply.com'
  },
  material: lp.material,
  category: t(`col.${p.primaryCollection}.name` as any) || p.primaryCollectionName,
  weight: {
    '@type': 'QuantitativeValue',
    value: parseFloat(p.weight) || 25,
    unitCode: 'GRM'
  },
  additionalProperty: (Array.isArray(lp.specs) ? lp.specs : Object.entries(lp.specs || {})).map(([name, value]: [string, any]) => ({
    '@type': 'PropertyValue',
    name: String(name),
    value: String(value)
  })),
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: minOfferPrice,
    highPrice: maxOfferPrice,
    offerCount: Math.max(1, (p.variants || []).length) * 3,
    itemCondition: 'https://schema.org/NewCondition',
    availability: 'https://schema.org/InStock',
    url: canonicalProductUrl,
    seller: {
      '@type': 'Organization',
      name: 'MedalPinSupply.com — Zhongshan Custom Pins, Medals & Coins Foundry',
      url: 'https://medalpinsupply.com'
    },
    offers: (lp.variants || p.variants || []).map((v: any, idx: number) => ({
      '@type': 'Offer',
      name: `${lp.title} — ${v.materialLocalized || v.materialEn || lp.material}`,
      sku: v.sku || `${p.sku}-V${idx + 1}`,
      priceCurrency: 'USD',
      price: v.tier2000 || p.tier2000,
      priceValidUntil: '2027-12-31',
      itemCondition: 'https://schema.org/NewCondition',
      availability: 'https://schema.org/InStock',
      url: canonicalProductUrl,
      eligibleQuantity: {
        '@type': 'QuantitativeValue',
        minValue: p.moqNum || 100,
        unitCode: 'C62'
      }
    }))
  },
  isRelatedTo: relatedProducts.map((rel: any) => {
    const rd = rel.data || rel;
    return {
      '@type': 'Product',
      sku: rd.sku,
      name: localizeTitle(rd.title, currentLang),
      url: `https://medalpinsupply.com${getLocalizedPath(`/products/${rd.slug}`, currentLang)}`
    };
  })
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: lp.faqs.map((f: any) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: `https://medalpinsupply.com${getLocalizedPath('/', currentLang)}` },
    { '@type': 'ListItem', position: 2, name: t(`col.${p.primaryCollection}.short` as any), item: `https://medalpinsupply.com${getLocalizedPath(`/collections/${p.primaryCollection}`, currentLang)}` },
    { '@type': 'ListItem', position: 3, name: lp.title, item: `https://medalpinsupply.com${getLocalizedPath(`/products/${p.slug}`, currentLang)}` }
  ]
};
---

<Layout
  title={lp.metaTitle}
  description={lp.metaDescription}
  ogImage={p.featuredImage}
  preloadImage={p.featuredImage}
  activePage="products"
  jsonLd={[productSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Breadcrumb Bar -->
  <div class="pdp-breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
        <a href={getLocalizedPath('/', currentLang)}>{t('breadcrumb.home')}</a>
        <span>/</span>
        <a href={getLocalizedPath('/products', currentLang)}>{t('breadcrumb.allCatalog')}</a>
        <span>/</span>
        <a href={getLocalizedPath(`/collections/${p.primaryCollection}`, currentLang)}>{t(`col.${p.primaryCollection}.short` as any)}</a>
        <span>/</span>
        <strong>{lp.title}</strong>
      </nav>
      <div class="pdp-cross-links">
        {p.readyMold && (
          <a href={getLocalizedPath('/collections/custom-enamel-pins', currentLang)} class="cross-pill pill-logo">{t('nav.logoReady')}</a>
        )}
        {p.enamelCraft && (
          <a href={getLocalizedPath('/collections/custom-medals', currentLang)} class="cross-pill pill-tuning">{t('nav.tuningFork')}</a>
        )}
        {p.dieCast3d && (
          <a href={getLocalizedPath('/collections/custom-challenge-coins', currentLang)} class="cross-pill pill-cnc">{t('nav.cncExotic')}</a>
        )}
      </div>
    </div>
  </div>

  <!-- =====================================================================
       STAGE 1: Hero Gallery + SKU, 3-Tier Wholesale Pricing, Material Switcher & 4 Custom Radio Boxes
       ===================================================================== -->
  <section class="section pdp-stage-1">
    <div class="container pdp-hero-grid">
      <!-- Left: Product Gallery -->
      <div class="pdp-gallery">
        <div class="main-image-frame">
          <img
            id="pdp-main-img"
            src={p.featuredImage}
            alt={`${lp.title} - ${lp.material}`}
            width="800"
            height="600"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
          <div class="frame-badges">
            <span class="badge badge-emerald">{t('pdp.readyMold')}</span>
          </div>
        </div>

        {allImages.length > 1 && (
          <div class="thumb-strip">
            {allImages.map((img: string, idx: number) => (
              <button
                type="button"
                class:list={['thumb-btn', { active: idx === 0 }]}
                data-img={img}
                aria-label={`View angle ${idx + 1}`}
              >
                <img src={img} alt={`${lp.title} - ${idx + 1}`} width="120" height="90" />
              </button>
            ))}
          </div>
        )}

        <!-- Quick Spec Highlights Under Image -->
        <div class="gallery-quick-kpis">
          <div class="qkpi">
            <span>{t('pdp.dimensions')}</span>
            <strong>{p.size}</strong>
          </div>
          <div class="qkpi">
            <span>{t('pdp.netWeight')}</span>
            <strong id="display-weight">{p.weight}</strong>
          </div>
          <div class="qkpi">
            <span>{t('pdp.blankMoq')}</span>
            <strong>{p.moqNum || 100} {t('unit.pcs')}</strong>
          </div>
          <div class="qkpi">
            <span>{t('pdp.logoMoq')}</span>
            <strong>{p.toolingFee.includes('1,000') || p.toolingFee.includes('1k') ? '1,000+ Free' : '500+ Free'}</strong>
          </div>
        </div>

        <!-- Engineering & Custom Branding Summary Card Under Gallery -->
        <div class="gallery-spec-card">
          <div class="gsc-row">
            <span class="gsc-label">{t('card.material').replace(':', '')}</span>
            <strong class="gsc-val" id="gallery-mat-val">{lp.material}</strong>
          </div>
          <div class="gsc-row">
            <span class="gsc-label">{t('card.magnets').replace(':', '')}</span>
            <strong class="gsc-val">{lp.magnets}</strong>
          </div>
          <div class="gsc-badges">
            <span>{t('pdp.trust1')}</span>
            <span>{t('pdp.trust2')}</span>
            <span>{t('pdp.trust3')}</span>
          </div>
        </div>
      </div>

      <!-- Right: Golden Stage-1 Wholesale Configuration & Pricing Panel -->
      <div class="pdp-config-panel">
        <div class="pdp-meta-top">
          <span class="sku-code-large" id="display-sku">{t(`col.${p.primaryCollection}.short` as any)}</span>
          <span class="factory-ref">{t('pdp.readyMold')} · {p.size}</span>
        </div>

        <h1 class="pdp-title">{lp.title}</h1>
        <p class="pdp-short-overview">{lp.overview}</p>

        <!-- Multi-Size / Craft Variant Switcher -->
        {lp.variants && lp.variants.length > 1 && (
          <div class="variant-selector-box">
            <div class="selector-label">
              <strong>{t('pdp.variantSelectTitle')} ({lp.variants.length}):</strong>
              <span>{t('pdp.variantSelectSub')}</span>
            </div>
            <div class="variant-buttons">
              {lp.variants.map((v: any, idx: number) => (
                <button
                  type="button"
                  class:list={['variant-btn', { active: idx === 0 }]}
                  data-sku={lp.title}
                  data-material={v.materialLocalized}
                  data-weight={v.weight}
                  data-t100={v.tier100}
                  data-t500={v.tier500}
                  data-t2000={v.tier2000}
                >
                  <span class="v-sku">{v.size || v.materialLocalized.split('(')[0].trim()}</span>
                  <span class="v-price">${v.tier2000} – ${v.tier100} ({v.weight})</span>
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- 3-Tier Reference Factory-Direct Wholesale Price Table -->
        <div class="pricing-tiers-box">
          <div class="tiers-header">
            <span>{t('pdp.pricingTitle')}</span>
            <span class="tooling-free-tag">✓ {t('pdp.noMoldFee')}</span>
          </div>
          <div class="tiers-grid">
            <div class="tier-cell" data-tier-qty="100" role="button" tabindex="0">
              <span class="tier-qty">100 – 499 {t('unit.pcs')}</span>
              <strong class="tier-val" id="price-tier-100">${p.tier100}</strong>
              <span class="tier-sub">{t('pdp.trialBatch')}</span>
            </div>
            <div class="tier-cell tier-popular" data-tier-qty="500" role="button" tabindex="0">
              <span class="tier-qty">500 – 1,999 {t('unit.pcs')}</span>
              <strong class="tier-val" id="price-tier-500">${p.tier500}</strong>
              <span class="tier-sub">{t('pdp.customLogoStd')}</span>
            </div>
            <div class="tier-cell tier-best" data-tier-qty="2000" role="button" tabindex="0">
              <span class="tier-qty">2,000+ {t('unit.pcs')}</span>
              <strong class="tier-val" id="price-tier-2000">${p.tier2000}</strong>
              <span class="tier-sub">{t('pdp.volumeTier')}</span>
            </div>
          </div>
        </div>

        <!-- 4 Customization Radio Options -->
        <div class="custom-options-box">
          <div class="custom-options-title">
            <strong>{t('pdp.selectBranding')}</strong>
            <span>{t('pdp.readyMold')}</span>
          </div>

          <div class="radio-grid" id="custom-radio-group">
            <label class="radio-card active">
              <input type="radio" name="custom_mode" value="Standard Enamel / Cast Spec" data-addon="0" data-min-qty={String(p.moqNum || 100)} checked />
              <div class="radio-info">
                <strong>{t('pdp.opt1Title')}</strong>
                <span>{t('pdp.opt1Desc')}</span>
              </div>
            </label>

            <label class="radio-card">
              <input type="radio" name="custom_mode" value="Two-Tone / Specialty Enamel (+$0.12-$0.35/pc)" data-addon="0.20" data-min-qty={String(p.moqNum || 100)} />
              <div class="radio-info">
                <strong>{t('pdp.opt2Title')}</strong>
                <span>{t('pdp.opt2Desc')}</span>
              </div>
            </label>

            <label class="radio-card">
              <input type="radio" name="custom_mode" value="Backing Cards, Capsules or Velvet Gift Box" data-addon="0.32" data-min-qty="100" />
              <div class="radio-info">
                <strong>{t('pdp.opt3Title')}</strong>
                <span>{t('pdp.opt3Desc')}</span>
              </div>
            </label>

            <label class="radio-card">
              <input type="radio" name="custom_mode" value="Pre-Production Physical Sample + 12h Free Proof" data-addon="0" data-min-qty="50" />
              <div class="radio-info">
                <strong>{t('pdp.opt4Title')}</strong>
                <span>{t('pdp.opt4Desc')}</span>
              </div>
            </label>
          </div>

          <!-- Instant Factory Quote Calculator -->
          <div class="instant-calc-bar" id="pdp-instant-calc" data-base100={p.tier100} data-base500={p.tier500} data-base2000={p.tier2000} data-default-moq={String(p.moqNum || 100)}>
            <div class="calc-qty-row">
              <span class="calc-qty-label">{t('contact.quantity')}:</span>
              <div class="calc-qty-chips" role="group" aria-label={t('contact.quantity')}>
                <button type="button" class="calc-qty-chip chip-sample" data-qty="1">{microHooks.sample1Pc}</button>
                <button type="button" class="calc-qty-chip" data-qty="50">50 {t('unit.pcs')}</button>
                <button type="button" class="calc-qty-chip active" data-qty="100">100 {t('unit.pcs')}</button>
                <button type="button" class="calc-qty-chip" data-qty="500">500 {t('unit.pcs')}</button>
                <button type="button" class="calc-qty-chip" data-qty="1000">1,000 {t('unit.pcs')}</button>
                <button type="button" class="calc-qty-chip" data-qty="2000">2,000 {t('unit.pcs')}</button>
              </div>
            </div>
            <div class="calc-summary-row">
              <div class="calc-unit-col">
                <span class="calc-meta-label">{microHooks.unitPriceLabel}</span>
                <strong class="calc-unit-val" id="calc-unit-display" data-free-proof={microHooks.freeLogoProof}>${p.tier100}<span>/{t('unit.pc')}</span></strong>
              </div>
              <div class="calc-total-col">
                <span class="calc-meta-label">{microHooks.estTotalLabel} · <span id="calc-qty-display">100</span> {t('unit.pcs')}</span>
                <strong class="calc-total-val" id="calc-total-display">${(parseFloat(p.tier100) * 100).toFixed(2)} USD</strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Single Focused Conversion Zone (Option A: Direct 1-Field Email/WhatsApp Box + Full Form Link) -->
        <form
          class="inline-quick-sheet-form pdp-direct-lead-box"
          id="pdp-inline-lead-form"
          data-inline-sku={`${lp.title} — ${p.moqNum || 100} pcs Custom Spec`}
        >
          <div class="pdp-direct-input-row">
            <input
              type="email"
              class="inline-qrfq-input pdp-direct-input"
              placeholder={microHooks.pdpInputPlaceholder}
              required
              aria-label={microHooks.pdpInputPlaceholder}
            />
            <button type="submit" class="inline-qrfq-btn pdp-direct-submit" id="pdp-direct-submit-btn">
              {microHooks.pdpDirectSendBtn}
            </button>
          </div>
          <span class="inline-qrfq-status pdp-direct-status" hidden>{microHooks.pdpSentConfirm}</span>
          <div class="pdp-direct-footer">
            <a href={getLocalizedPath('/sample-kit', currentLang)} class="pdp-direct-badge" style="text-decoration: none;">{microHooks.mixMoqBadge}</a>
            <a
              id="pdp-rfq-btn"
              data-rfq-base={rfqBaseUrl}
              data-rfq-sku={lp.title}
              data-rfq-mode="Standard Enamel / Cast Spec"
              data-rfq-qty={String(p.moqNum || 100)}
              href={rfqBaseUrl}
              class="pdp-full-form-link"
            >
              {t('pdp.requestQuote')} →
            </a>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       STAGE 2: Standard HTML Engineering Parameter Table (Factory Crawler Zone)
       ===================================================================== -->
  <section class="section section-light pdp-stage-2">
    <div class="container">
      <GeoDirectAnswer
        title={`${lp.title} — ${t('pdp.specsTitle')}`}
        answer={lp.overview}
        metrics={[
          { label: t('pdp.prodMold'), value: t('pdp.readyMold') },
          { label: t('card.material').replace(':', ''), value: lp.material.split('/')[0].trim() },
          { label: `${t('pdp.dimensions')} / ${t('pdp.netWeight')}`, value: `${p.size} / ${p.weight}` },
          { label: t('card.magnets').replace(':', ''), value: lp.magnets.slice(0, 36) }
        ]}
      />

      <div class="stage-2-grid">
        <div>
          <h2 class="stage-heading">{t('pdp.specsTitle')}</h2>
          <p class="stage-sub">
            {t('pdp.specsSub')}
          </p>
          <div class="geo-table-wrap">
            <table class="geo-table">
              <thead>
                <tr>
                  <th style="width: 34%;">{t('pdp.specColParam')}</th>
                  <th>{t('pdp.specColVal')}</th>
                </tr>
              </thead>
              <tbody>
                {lp.specs.map(([key, val]) => (
                  <tr>
                    <td><strong>{key}</strong></td>
                    <td>{val}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {lp.variants && lp.variants.length > 1 && (
            <div style="margin-top: 2rem;">
              <h3 style="margin-bottom: 0.75rem; font-size: 1.15rem;">{t('pdp.variantMatrixTitle')}</h3>
              <div class="geo-table-wrap">
                <table class="geo-table">
                  <thead>
                    <tr>
                      <th>{t('col.thName')}</th>
                      <th>{t('card.material').replace(':', '')}</th>
                      <th>{t('pdp.dimensions')}</th>
                      <th>{t('pdp.netWeight')}</th>
                      <th>100–499</th>
                      <th>500–1,999</th>
                      <th>2,000+</th>
                    </tr>
                  </thead>
                  <tbody>
                    {lp.variants.map((v: any) => (
                      <tr>
                        <td><strong>{v.name || lp.title}</strong></td>
                        <td>{v.materialLocalized}</td>
                        <td>{v.size}</td>
                        <td>{v.weight}</td>
                        <td>${v.tier100}</td>
                        <td>${v.tier500}</td>
                        <td><strong>${v.tier2000}</strong></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>

        <div class="features-column">
          <h2 class="stage-heading">{t('pdp.highlightsTitle')}</h2>
          <p class="stage-sub">{t('pdp.highlightsSub')}</p>
          <div class="feature-cards">
            {lp.features.map((feat: string) => (
              <div class="feat-card">
                <span class="feat-check">✓</span>
                <p>{feat}</p>
              </div>
            ))}
          </div>

          <!-- =====================================================================
               STAGE 3: Anti-Tooling Lock-In Declaration Box
               ===================================================================== -->
          <div class="anti-tooling-declaration">
            <div class="decl-badge">{t('pdp.declBadge')}</div>
            <h3>{t('pdp.declTitle')}</h3>
            <p class="decl-quote">
              "{t('pdp.declQuote')}"
            </p>
            <div class="decl-links">
              <a href={getLocalizedPath('/custom-branding', currentLang)}>{t('pdp.declLink1')}</a>
              <a href={getLocalizedPath('/custom-packaging', currentLang)}>{t('pdp.declLink2')}</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Localized Product Technical Deep-Dive & Customization Article Section -->
      <div class="pdp-editorial-card clean-editorial-content" set:html={lp.editorialHtml} />
    </div>
  </section>

  <!-- Product FAQs -->
  <section class="section">
    <div class="container">
      <div class="section-header-center">
        <span class="badge">{t('pdp.faqBadge')}</span>
        <h2 class="section-title">{t('pdp.faqTitle')} — {lp.title}</h2>
      </div>
      <div class="faq-list">
        {lp.faqs.map((faq: any, idx: number) => (
          <div class:list={['accordion-item', { active: idx === 0 }]}>
            <button type="button" class="accordion-header">
              <span>{faq.question}</span>
              <span class="accordion-icon">+</span>
            </button>
            <div class="accordion-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Products in Same Collection -->
  {relatedProducts.length > 0 && (
    <section class="section section-light">
      <div class="container">
        <div class="section-header-center">
          <span class="badge">{t('pdp.relatedBadge')}</span>
          <h2 class="section-title">{t('pdp.relatedTitle')}</h2>
        </div>
        <div class="grid-4">
          {relatedProducts.map((rel: any) => (
            <ProductCard product={rel} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Engineering & Sourcing Insights (Bidirectional Mesh) -->
  {relatedGuides.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header-center">
          <span class="badge">{t('guide.continueBadge')}</span>
          <h2 class="section-title">{t('guide.relatedGuidesTitle')}</h2>
        </div>
        <div class="pdp-guides-grid">
          {relatedGuides.map((rg: any) => {
            const rgLoc = localizeInsightMeta(rg.data, currentLang);
            return (
              <a href={getLocalizedPath(`/insights/${rg.data.slug}`, currentLang)} class="pdp-guide-card">
                <img src={rg.data.featuredImage} alt={rgLoc.title} width="400" height="300" loading="lazy" />
                <div class="pdp-guide-body">
                  <span class="pdp-guide-cat">{rgLoc.category}</span>
                  <h3>{rgLoc.title}</h3>
                  <p>{rgLoc.summary}</p>
                  <span class="pdp-guide-cta">{t('guides.readCta')}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
  <!-- Mobile Fixed Bottom Instant Conversion Bar -->
  <div class="pdp-mobile-sticky-bar" role="region" aria-label={t('pdp.requestQuote')}>
    <div class="sticky-sku-col">
      <strong class="sticky-sku-code" id="sticky-sku-code">{lp.title}</strong>
      <span class="sticky-sku-price" id="sticky-sku-price">${p.tier2000} – ${p.tier100} · MOQ {p.moqNum || 100}</span>
    </div>
    <div class="sticky-action-col">
      <a
        id="pdp-sticky-wa-btn"
        href={`https://wa.me/8618750126315?text=${encodeURIComponent(`Hello MedalPinSupply, I would like wholesale pricing & a 12h free artwork proof for custom ${p.title}.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-sticky-wa"
        aria-label="WhatsApp"
      >
        WhatsApp
      </a>
      <a
        id="pdp-sticky-rfq-btn"
        data-rfq-base={rfqBaseUrl}
        data-rfq-sku={lp.title}
        data-rfq-mode="Standard Enamel / Cast Spec"
        data-rfq-qty={String(p.moqNum || 100)}
        href={rfqBaseUrl}
        class="btn-sticky-rfq"
      >
        {t('pdp.requestQuote')} →
      </a>
