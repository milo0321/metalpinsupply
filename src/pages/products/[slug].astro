</Layout>

<script is:inline>
  (function () {
    // Gallery thumbnail switching
    const mainImg = document.getElementById('pdp-main-img');
    const thumbBtns = document.querySelectorAll('.thumb-btn');
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-img');
        if (src && mainImg) mainImg.setAttribute('src', src);
        thumbBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    // Multi-variant switching & tiered calculator
    let currentSku = (document.querySelector('.pdp-title')?.textContent || document.getElementById('display-sku')?.textContent || 'Custom Craft').trim();
    const variantBtns = document.querySelectorAll('.variant-btn');
    const price100 = document.getElementById('price-tier-100');
    const price500 = document.getElementById('price-tier-500');
    const price2000 = document.getElementById('price-tier-2000');
    const weightEl = document.getElementById('display-weight');
    const skuEl = document.getElementById('display-sku');
    const rfqBtn = document.getElementById('pdp-rfq-btn');
    const fastRfqBtn = document.getElementById('pdp-fast-rfq-btn');
    const stickyRfqBtn = document.getElementById('pdp-sticky-rfq-btn');
    const fastPriceEl = document.getElementById('fast-price-display');
    const stickySkuEl = document.getElementById('sticky-sku-code');
    const stickyPriceEl = document.getElementById('sticky-sku-price');
    const calcBox = document.getElementById('pdp-instant-calc');
    const calcUnitEl = document.getElementById('calc-unit-display');
    const calcQtyEl = document.getElementById('calc-qty-display');
    const calcTotalEl = document.getElementById('calc-total-display');
    const qtyChips = document.querySelectorAll('.calc-qty-chip');
    let currentQty = 100;

    function updateRfqHref() {
      if (!rfqBtn) return;
      const checkedRadio = document.querySelector('input[name="custom_mode"]:checked');
      const mode = currentQty === 1 ? 'Pre-Production Sample + Free 12h Proof' : (checkedRadio ? checkedRadio.value : 'Standard Spec');
      const addon = checkedRadio ? parseFloat(checkedRadio.getAttribute('data-addon') || '0') : 0;
      const minQty = checkedRadio ? parseInt(checkedRadio.getAttribute('data-min-qty') || '50', 10) : 50;

      if (currentQty !== 1 && currentQty < minQty) {
        currentQty = minQty;
        qtyChips.forEach((chip) => {
          chip.classList.toggle('active', parseInt(chip.getAttribute('data-qty') || '0', 10) === currentQty);
        });
      }

      if (calcBox) {
        const b100 = parseFloat(calcBox.getAttribute('data-base100') || '0');
        const b500 = parseFloat(calcBox.getAttribute('data-base500') || '0');
        const b2000 = parseFloat(calcBox.getAttribute('data-base2000') || '0');
        const basePrice = currentQty >= 2000 ? b2000 : currentQty >= 500 ? b500 : b100;
        const unitTotal = basePrice + addon;
        const subtotal = currentQty === 1 ? unitTotal : unitTotal * currentQty;
        if (calcUnitEl) {
          const unitSuffix = calcUnitEl.getAttribute('data-unit-suffix') || calcUnitEl.querySelector('span')?.outerHTML || '<span>/pc</span>';
          if (!calcUnitEl.getAttribute('data-unit-suffix')) {
            calcUnitEl.setAttribute('data-unit-suffix', unitSuffix);
          }
          calcUnitEl.innerHTML = currentQty === 1 ? `$${basePrice.toFixed(2)} + Proof<span>/pc</span>` : `$${unitTotal.toFixed(2)}${unitSuffix}`;
        }
        if (calcQtyEl) calcQtyEl.textContent = currentQty.toLocaleString();
        if (calcTotalEl) {
          const freeProofLabel = calcUnitEl?.getAttribute('data-free-proof') || '12h Free Vector Proof';
          calcTotalEl.textContent = currentQty === 1 ? `Sample + ${freeProofLabel}` : `$${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} USD`;
        }
        if (stickyPriceEl) {
          stickyPriceEl.textContent = currentQty === 1 ? `Sample (${currentSku}) · Free 12h Proof` : `$${unitTotal.toFixed(2)}/pc × ${currentQty} ($${subtotal.toFixed(0)} USD)`;
        }

        const waMsg = currentQty === 1
          ? `Hello MedalPinSupply, please send a free 12h vector artwork proof & sample fee quote for ${currentSku}.`
          : `Hello MedalPinSupply, please quote ${currentQty} pcs of ${currentSku} (${mode}) at ~$${unitTotal.toFixed(2)}/pc (Est. $${subtotal.toFixed(2)} USD).`;
        const waUrl = `https://wa.me/8618750126315?text=${encodeURIComponent(waMsg)}`;
        ['pdp-main-wa-btn', 'pdp-sticky-wa-btn'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) el.setAttribute('href', waUrl);
        });
        const inlineLeadForm = document.getElementById('pdp-inline-lead-form');
        if (inlineLeadForm) {
          inlineLeadForm.setAttribute(
            'data-inline-sku',
            `${currentSku} — ${currentQty} pcs (${mode}, $${unitTotal.toFixed(2)}/pc)`
          );
        }
      }

      [rfqBtn, stickyRfqBtn].forEach((btn) => {
        if (!btn) return;
        btn.setAttribute('data-rfq-sku', currentSku);
        btn.setAttribute('data-rfq-mode', mode);
        btn.setAttribute('data-rfq-qty', String(currentQty));
      });
    }

    qtyChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const selectedQty = parseInt(chip.getAttribute('data-qty') || '100', 10);
        currentQty = selectedQty;
        qtyChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        updateRfqHref();
      });
    });

    variantBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        variantBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentSku = btn.getAttribute('data-sku') || currentSku;
        const t100 = btn.getAttribute('data-t100') || '';
        const t500 = btn.getAttribute('data-t500') || '';
        const t2000 = btn.getAttribute('data-t2000') || '';
        if (price100) price100.textContent = '$' + t100;
        if (price500) price500.textContent = '$' + t500;
        if (price2000) price2000.textContent = '$' + t2000;
        if (fastPriceEl && t2000 && t100) {
          const suffix = fastPriceEl.querySelector('span')?.outerHTML || '';
          fastPriceEl.innerHTML = `$${t2000} – $${t100}${suffix}`;
        }
        if (stickySkuEl) stickySkuEl.textContent = currentSku;
        if (stickyPriceEl && t2000 && t100) stickyPriceEl.textContent = `$${t2000} – $${t100} · MOQ 100`;
        if (calcBox) {
          if (t100) calcBox.setAttribute('data-base100', t100);
          if (t500) calcBox.setAttribute('data-base500', t500);
          if (t2000) calcBox.setAttribute('data-base2000', t2000);
        }
        if (weightEl) weightEl.textContent = btn.getAttribute('data-weight') || '';
        const galleryMatEl = document.getElementById('gallery-mat-val');
        if (galleryMatEl && btn.getAttribute('data-material')) {
          galleryMatEl.textContent = btn.getAttribute('data-material') || '';
        }
        updateRfqHref();
      });
    });

    // GA4 Tracking for Fast-Action & Mobile Sticky Conversion Bars
    if (fastRfqBtn) {
      fastRfqBtn.addEventListener('click', () => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'pdp_fast_rfq_click', { sku: currentSku, qty: currentQty });
        }
      });
    }
    if (stickyRfqBtn) {
      stickyRfqBtn.addEventListener('click', () => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'pdp_sticky_rfq_click', { sku: currentSku, qty: currentQty });
        }
      });
    }
    const fastWaBtn = document.getElementById('pdp-fast-wa-btn');
    if (fastWaBtn) {
      fastWaBtn.addEventListener('click', () => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'pdp_fast_whatsapp_click', { sku: currentSku });
        }
      });
    }
    const stickyWaBtn = document.getElementById('pdp-sticky-wa-btn');
    if (stickyWaBtn) {
      stickyWaBtn.addEventListener('click', () => {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'pdp_sticky_whatsapp_click', { sku: currentSku });
        }
      });
    }

    // Interactive 3-tier price table cells
    const tierCells = document.querySelectorAll('.tiers-grid .tier-cell[data-tier-qty]');
    tierCells.forEach((cell) => {
      cell.addEventListener('click', () => {
        const selectedQty = parseInt(cell.getAttribute('data-tier-qty') || '100', 10);
        currentQty = selectedQty;
        qtyChips.forEach((c) => {
          c.classList.toggle('active', parseInt(c.getAttribute('data-qty') || '0', 10) === selectedQty);
        });
        updateRfqHref();
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'tier_cell_select', { sku: currentSku, qty: currentQty });
        }
      });
    });

    // Customization radio cards
    const radioCards = document.querySelectorAll('#custom-radio-group .radio-card');
    radioCards.forEach((card) => {
      card.addEventListener('click', () => {
        radioCards.forEach((c) => c.classList.remove('active'));
        card.classList.add('active');
        const input = card.querySelector('input[type="radio"]');
        if (input) input.checked = true;
        updateRfqHref();
      });
    });
  })();
</script>

